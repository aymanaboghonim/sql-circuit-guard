# ==============================================================================
# Hugging Face Spaces CPU Runtime: sql-circuit-guard
# ------------------------------------------------------------------------------
# Cloud-only configuration: all inference routes to Gemini (LiteLLM) behind the
# 10 RPM / 200k TPM token-bucket rate limiter. No Ollama/GPU required.
# GEMINI_API_KEY is injected at runtime via Space Secrets (never baked in).
# ==============================================================================
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

# Enable bytecode compilation and frozen sync
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy dependency specifications first for Docker layer caching
COPY pyproject.toml uv.lock ./

# Sync dependencies without installing the project root package yet
RUN uv sync --frozen --no-install-project --no-dev

# Copy application source code, readme, and dataset
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
COPY data/ ./data/

# Sync project package itself
RUN uv sync --frozen --no-dev


# ==============================================================================
# Stage 2: Clean Runtime Image (HF Spaces: runs as UID 1000)
# ==============================================================================
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

# Hugging Face Spaces runs containers as user ID 1000 — create matching user.
RUN useradd -m -u 1000 user

# Copy virtual environment and necessary data from builder stage
COPY --from=builder --chown=user:user /app/.venv /app/.venv
COPY --from=builder --chown=user:user /app/src /app/src
COPY --from=builder --chown=user:user /app/data /app/data

# Ensure virtual environment binaries take precedence in PATH
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME="/home/user" \
    ENABLE_CLOUD_FALLBACK="true" \
    LOCAL_MODEL_NAME="gemini/gemini-3.1-flash-lite" \
    CLOUD_MODEL_NAME="gemini/gemini-3.1-flash-lite" \
    ENABLE_LANGFUSE="false"

USER user
EXPOSE 7860

ENTRYPOINT ["python", "src/app.py"]
