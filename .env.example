# ==============================================================================
# SQL-CIRCUIT-GUARD ENVIRONMENT VARIABLES
# ==============================================================================

# 1. LOCAL INFERENCE ENGINE (OLLAMA / WSL2 RTX 3070 8GB)
OLLAMA_API_BASE="http://localhost:11434"
LOCAL_MODEL_NAME="ollama/ibm/granite4.1:8b"

# 2. CLOUD FALLBACK ENGINE (GEMINI AI STUDIO - FREE TIER)
# Strict limits: 10 RPM / 200k TPM / 400 RPD
GEMINI_API_KEY="your-gemini-studio-api-key-here"
CLOUD_MODEL_NAME="gemini/gemini-3.1-flash-lite"
ENABLE_CLOUD_FALLBACK="true"

# 3. TELEMETRY & OBSERVABILITY (SELF-HOSTED LANGFUSE / DOCKER COMPOSE)
LANGFUSE_PUBLIC_KEY="pk-lf-local-demo-key"
LANGFUSE_SECRET_KEY="sk-lf-local-demo-key"
LANGFUSE_HOST="http://localhost:3000"
